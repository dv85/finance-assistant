{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merchant-profiles.schema.json",
  "title": "Reusable merchant identity profiles",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "enabled", "reviewed", "match", "normalizedName", "description"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "enabled": { "type": "boolean" },
      "reviewed": { "type": "boolean" },
      "observedCount": { "type": "integer", "minimum": 0 },
      "match": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "merchantEquals": { "$ref": "#/$defs/textOrTexts" },
          "merchantContains": { "$ref": "#/$defs/textOrTexts" },
          "descriptionContains": { "$ref": "#/$defs/textOrTexts" }
        },
        "additionalProperties": false
      },
      "normalizedName": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "textOrTexts": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
