{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger.schema.json",
  "title": "Finance Assistant durable ledger v2",
  "type": "object",
  "required": ["schemaVersion", "currency", "transactions", "cardAllocations", "cashMovements", "balanceSnapshots", "importRuns", "categoryRules", "merchantProfiles", "accounts"],
  "additionalProperties": false,
  "properties": {
    "installmentPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purchaseDate", "purchaseAmount", "transactionIds", "status", "schedule"],
        "properties": {
          "id": { "type": "string" },
          "purchaseDate": { "type": "string", "format": "date" },
          "purchaseAmount": { "type": "number", "minimum": 0 },
          "transactionIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "status": { "enum": ["ready", "needs_review"] },
          "schedule": { "type": "array", "items": { "type": "object", "required": ["id", "number", "date", "amount", "estimated"] } }
        }
      }
    },
    "schemaVersion": { "const": 2 },
    "currency": { "type": "string", "minLength": 1 },
    "transactions": { "type": "array", "items": { "$ref": "#/$defs/transaction" } },
    "cardAllocations": { "type": "array", "items": { "$ref": "#/$defs/allocation" } },
    "cashMovements": { "type": "array", "items": { "$ref": "#/$defs/cashMovement" } },
    "balanceSnapshots": { "type": "array", "items": { "$ref": "#/$defs/balance" } },
    "importRuns": { "type": "array", "items": { "type": "object" } },
    "maintenanceRuns": { "type": "array", "items": { "type": "object" } },
    "categoryRules": { "type": "array", "items": { "type": "object" } },
    "merchantProfiles": { "type": "array", "items": { "$ref": "#/$defs/merchantProfile" } },
    "accounts": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type", "currency"] } }
    ,"recurringCosts": { "type": "array", "items": { "type": "object", "required": ["id", "name", "category", "cadence", "monthlyFunding", "fundingMethod", "status"], "additionalProperties": true } }
  },
  "$defs": {
    "merchantProfile": {
      "type": "object",
      "required": ["id", "enabled", "reviewed", "match", "normalizedName", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "reviewed": { "type": "boolean" },
        "match": { "type": "object", "minProperties": 1 },
        "normalizedName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "date": { "type": "string", "format": "date" },
    "sourceRef": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "firstSeenAt": { "type": "string", "format": "date-time" } },
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "required": ["id", "fingerprint", "account_id", "date", "description", "normalizedMerchantName", "merchantDescription", "merchantProfileReviewed", "merchantReviewRequired", "merchantDescriptionSource", "amount", "currency", "direction", "type", "category", "sourceRefs", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "fingerprint": { "type": "string", "minLength": 1 }, "account_id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" }, "billingDate": { "type": ["string", "null"], "format": "date" }, "isInstallment": { "type": "boolean" },
        "purchaseAmount": { "type": "number" }, "originalCurrency": { "type": "string" }, "isPending": { "type": "boolean" },
        "amountEstimated": { "type": "boolean" }, "estimatedFxRate": { "type": ["number", "null"] }, "estimationMethod": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 }, "merchant": { "type": "string" },
        "normalizedMerchantName": { "type": "string", "minLength": 1 }, "merchantDescription": { "type": "string", "minLength": 1 },
        "merchantProfileId": { "type": "string" }, "merchantProfileReviewed": { "type": "boolean" }, "merchantReviewRequired": { "type": "boolean" },
        "merchantDescriptionSource": { "enum": ["profile", "category_fallback", "manual"] },
        "amount": { "type": "number" }, "currency": { "type": "string" },
        "direction": { "enum": ["inflow", "outflow"] }, "type": { "type": "string" }, "category": { "type": "string" }, "cashMovementId": { "type": "string" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true,
      "allOf": [{ "if": { "properties": { "isInstallment": { "const": true } }, "required": ["isInstallment"] }, "then": { "required": ["billingDate"], "properties": { "billingDate": { "$ref": "#/$defs/date" } } } }]
    },
    "allocation": {
      "type": "object",
      "required": ["id", "fingerprint", "transactionId", "card", "purchaseDate", "billingDate", "merchant", "normalizedMerchantName", "merchantDescription", "merchantProfileReviewed", "merchantReviewRequired", "merchantDescriptionSource", "amount", "source", "createdAt", "updatedAt"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "type": "string" }, "transactionId": { "type": "string" }, "card": { "type": "string" }, "purchaseDate": { "$ref": "#/$defs/date" }, "billingDate": { "$ref": "#/$defs/date" }, "merchant": { "type": "string" }, "normalizedMerchantName": { "type": "string", "minLength": 1 }, "merchantDescription": { "type": "string", "minLength": 1 }, "merchantProfileId": { "type": "string" }, "merchantProfileReviewed": { "type": "boolean" }, "merchantReviewRequired": { "type": "boolean" }, "merchantDescriptionSource": { "enum": ["profile", "category_fallback", "manual"] }, "amount": { "type": "number" }, "purchaseAmount": { "type": "number" }, "originalCurrency": { "type": "string" }, "isPending": { "type": "boolean" }, "amountEstimated": { "type": "boolean" }, "estimatedFxRate": { "type": ["number", "null"] }, "estimationMethod": { "type": ["string", "null"] }, "source": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } },
      "additionalProperties": true
    },
    "cashMovement": {
      "type": "object",
      "required": ["id", "fingerprint", "account_id", "date", "description", "amount", "currency", "direction", "movementType", "sourceRefs", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" }, "fingerprint": { "type": "string" }, "account_id": { "type": "string" }, "date": { "$ref": "#/$defs/date" },
        "description": { "type": "string" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "type": "string" }, "direction": { "enum": ["inflow", "outflow"] },
        "movementType": { "enum": ["salary", "bank_credit", "card_settlement", "transfer", "cash_withdrawal", "fee", "direct_expense", "other"] },
        "reference": { "type": "string" }, "source": { "type": "string" }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "balance": {
      "type": "object",
      "required": ["id", "fingerprint", "account_id", "date", "observed_balance", "currency", "createdAt", "updatedAt"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "type": "string" }, "account_id": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "observed_balance": { "type": "number" }, "currency": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } },
      "additionalProperties": true
    }
  }
}
